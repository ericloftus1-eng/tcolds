# Copy this file to `.env` (or `.env.local`) and fill in your actual values.
# Never commit real secrets — this file only documents which variables are required.

# --- Supabase (required) ---
# Found in your Supabase project dashboard: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Site URL (recommended) ---
# The public URL where the app is deployed (used for metadata/OG tags).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Optional integrations ---
# Only required if the corresponding feature/integration is enabled.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ADSENSE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
